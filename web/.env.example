# Настройки локального web; make web-start загружает этот файл через Node --env-file.
NUXT_SCANNER_URL=http://212.46.3.67:58080
# PostgreSQL для аккаунтов, полки в аккаунте и отзывов. Пусто — без входа: сканер и полка
# в браузере работают как раньше. Схема создаётся сама при первом запросе.
# Значение ниже — контейнер postgres из docker-compose: make db.
NUXT_DATABASE_URL=postgres://wine:wine@127.0.0.1:5432/wine
# Пока СМС-провайдера нет, код входа показывается на экране. 0 — не отдавать код в ответе.
NUXT_AUTH_DEMO_CODES=1
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# Необязательно: HTTPS-туннель (make tunnel), токен из dashboard.ngrok.com.
NGROK_AUTHTOKEN=
# Закреплённый URL ngrok; пустое значение оставляет выбор адреса ngrok.
NGROK_URL=
