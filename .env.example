# Скопировать в .env (в git не попадает) и заполнить то, что используется.

# Облачный OCR: yandex | easyocr. Без ключей — easyocr.
WINE_OCR=easyocr
YANDEX_OCR_API_KEY=
YANDEX_FOLDER_ID=

# VLM-судья на спорных случаях (OpenAI-совместимый чат). Выключен без WINE_VLM=1.
# Примеры: Gemini — https://generativelanguage.googleapis.com/v1beta/openai, модель gemini-2.5-flash;
# OpenAI — https://api.openai.com/v1, модель gpt-4.1-mini.
WINE_VLM=0
WINE_VLM_BASE_URL=
WINE_VLM_MODEL=
WINE_VLM_API_KEY=

# Провайдер судьи: openai (переменные выше) или gigachat. Откат: WINE_VLM_FALLBACK=<провайдер>.
# GigaChat картинки этикеток не разбирает (отказ «чувствительная тема», проверено 17.09) —
# для судьи он не годится; без VPN остаётся Yandex AI Studio (OpenAI-совместимый endpoint
# https://llm.api.cloud.yandex.net/v1, нужна роль ai.languageModels.user у сервисного аккаунта).
WINE_VLM_PROVIDER=openai
WINE_VLM_FALLBACK=

# Цифровой сомелье (/sommelier). Провайдер: openai (WINE_LLM_* или, если пусто, WINE_VLM_*) или
# gigachat — текст GigaChat отвечает нормально и без VPN.
WINE_SOMMELIER=0
WINE_LLM_PROVIDER=gigachat
WINE_LLM_FALLBACK=openai
WINE_LLM_BASE_URL=
WINE_LLM_MODEL=
WINE_LLM_API_KEY=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_CA_BUNDLE=

# Eval-ручка: 1 — честный null на незнакомом вине (по умолчанию), 0 — всегда лучший кандидат.
WINE_EVAL_REFUSE=1

# Окно ре-ранкинга: 25 на процессоре, 50 на видеокарте.
WINE_RERANK_CANDIDATES=50
