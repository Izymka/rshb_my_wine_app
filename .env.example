# Скопировать в .env (в git не попадает) и заполнить то, что используется.

# PostgreSQL catalogue.  Docker Compose supplies the rest of DATABASE_URL itself.
POSTGRES_PASSWORD=wine_scanner
# For scripts executed on the host, set DATABASE_URL as follows:
# DATABASE_URL=postgresql+psycopg://wine_scanner:wine_scanner@localhost:5432/wine_scanner

# OCR: paddle (локальный, по умолчанию) | yandex (облачный с локальным откатом) |
# hybrid (PaddleOCR, затем Yandex Vision только при слабом тексте).
WINE_OCR=paddle
YANDEX_OCR_API_KEY=
YANDEX_FOLDER_ID=

# VLM-судья: выбирает между близнецами одной винодельни. Выключен без WINE_VLM=1 и даже
# включённым работает только в eval-ручке /v1/eval/predict (тест 85 → 91 из 93); в /scan он
# поднимает ложные приёмы незнакомых вин, и его туда возвращает только WINE_VLM_SCAN=1.
# Режим по умолчанию — family-verify (WINE_VLM_OPTIONS=family, WINE_VLM_TRIGGER=family,
# WINE_VLM_VERIFY=1), таймаут WINE_VLM_TIMEOUT=4 с укладывается в 10 с скрипта организатора.
# Провайдер по умолчанию — yandex: Yandex AI Studio, OpenAI-совместимый, работает без VPN.
# Ключ — сервисный аккаунт с ролью ai.languageModels.user; у самого ключа область действия
# должна включать yc.ai.languageModels.execute (ключ, выпущенный только под OCR, сервис
# языковых моделей не знает: «Unknown api key»). Если YANDEX_LLM_API_KEY пуст, берётся
# YANDEX_OCR_API_KEY — годится, когда один ключ выпущен на обе области.
WINE_VLM=1
WINE_VLM_SCAN=0
WINE_VLM_TIMEOUT=4
# Сверка выбора судьи с текстом, который он сам прочитал (цвет, сорт, сладость, различающие
# слова): стенд train 87 → 89 из 91, стресс 68 → 70 из 85; тест без изменений (91 из 93).
WINE_VLM_CHECK=1
# Строки PaddleOCR в промпт судьи: off / hint / hint-verify. На стенде не помогли (87 → 84–85).
WINE_VLM_OCR=off
# Сорт этикетки против поля grapes в правиле семьи (sibling_swap) без судьи: на стенде и тесте
# ничего не меняет, по умолчанию выключено.
WINE_GRAPE=0
WINE_VLM_PROVIDER=yandex
WINE_VLM_FALLBACK=
YANDEX_LLM_API_KEY=
# Модели AI Studio: картинки понимает qwen3.6-35b-a3b (судья); текст — yandexgpt-5-lite (сомелье).
# Полный URI gpt://<папка>/<модель> тоже принимается.
YANDEX_VLM_MODEL=qwen3.6-35b-a3b
YANDEX_LLM_MODEL=yandexgpt-5-lite
# YANDEX_LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Провайдер openai — любой OpenAI-совместимый чат (нужен VPN). Примеры: OpenAI —
# https://api.openai.com/v1, модель gpt-4.1-mini; Gemini —
# https://generativelanguage.googleapis.com/v1beta/openai, модель gemini-2.5-flash.
# Код оставлен, сейчас не используется: у ключа OpenAI нет кредитов (17.09).
WINE_VLM_BASE_URL=
WINE_VLM_MODEL=
WINE_VLM_API_KEY=

# Цифровой сомелье (/sommelier). Провайдер: yandex (ключи выше) или openai
# (WINE_LLM_* или, если пусто, WINE_VLM_*). Откат: WINE_LLM_FALLBACK=<провайдер>.
WINE_SOMMELIER=0
WINE_LLM_PROVIDER=yandex
WINE_LLM_FALLBACK=
WINE_LLM_BASE_URL=
WINE_LLM_MODEL=
WINE_LLM_API_KEY=

# Eval-ручка: 0 — всегда лучший кандидат (по умолчанию: заказчик проверяет вина каталога,
# и null засчитывается ошибкой), 1 — честный null на незнакомом вине.
WINE_EVAL_REFUSE=0

# Окно ре-ранкинга: 25 на процессоре, 50 на видеокарте.
WINE_RERANK_CANDIDATES=50
