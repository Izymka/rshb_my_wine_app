# Скопировать в .env (в git не попадает) и заполнить то, что используется.

# OCR: paddle (локальный, по умолчанию) | yandex (облачный с локальным откатом) |
# hybrid (PaddleOCR, затем Yandex Vision только при слабом тексте).
WINE_OCR=paddle
# PaddleOCR на видеокарте — отдельное окружение с paddlepaddle-gpu (src/wine_scanner/ocr/worker.py):
#   uv venv .venv-ocr --python 3.12
#   uv pip install --python .venv-ocr --index-url https://pypi.org/simple #     --extra-index-url https://www.paddlepaddle.org.cn/packages/stable/cu126/ paddlepaddle-gpu==3.3.1
#   uv pip install --python .venv-ocr paddleocr==3.7.0
# Пусто — OCR на CPU в отдельном процессе того же окружения. В Docker задано в образе.
WINE_OCR_PYTHON=
WINE_OCR_DEVICE=gpu:0
# Детектор строк PaddleOCR: PP-OCRv6_medium_det (сервис с 18.10.2026) | PP-OCRv6_small_det |
# PP-OCRv5_mobile_det (пусто — он, прежний) | PP-OCRv5_server_det.
WINE_OCR_DET=PP-OCRv6_medium_det
# Распознаватель строк: имя модели PaddleOCR или папка модели. Сервис с 18.10.2026 — PP-OCRv6
# medium, дообученный на русском (models/ocr_rec/PP-OCRv6_medium_rec_ru, ONNX; в окружении OCR
# нужен onnxruntime-gpu: uv pip install --python .venv-ocr onnxruntime-gpu==1.22.0). Пусто —
# прежний eslav_PP-OCRv5_mobile_rec. Решающий слой обучен под свой распознаватель:
# models/decider_site1810_abd (сервис с 19.10.2026) и models/decider_platform_sq_v3_v8 — под
# русский, models/decider_platform_sq_v3_v7 — под eslav.
WINE_DECIDER=models/decider_site1810_abd
WINE_OCR_REC=models/ocr_rec/PP-OCRv6_medium_rec_ru
YANDEX_OCR_API_KEY=
YANDEX_FOLDER_ID=

# VLM-судья: выбирает между близнецами одной винодельни. Выключен без WINE_VLM=1 и даже
# включённым работает только в eval-ручке /v1/eval/predict (тест 85 → 91 из 93); в /scan он
# поднимает ложные приёмы незнакомых вин, и его туда возвращает только WINE_VLM_SCAN=1.
# Режим по умолчанию — family-verify (WINE_VLM_OPTIONS=family, WINE_VLM_TRIGGER=family,
# WINE_VLM_VERIFY=1), таймаут WINE_VLM_TIMEOUT=4 с укладывается в 10 с скрипта организатора.
# Провайдер по умолчанию — yandex: Yandex AI Studio, OpenAI-совместимый, работает без VPN.
# Ключ — сервисный аккаунт с ролью ai.languageModels.user; у самого ключа область действия
# должна включать yc.ai.languageModels.execute (ключ, выпущенный только под OCR, сервис
# языковых моделей не знает: «Unknown api key»). Если YANDEX_LLM_API_KEY пуст, берётся
# YANDEX_OCR_API_KEY — годится, когда один ключ выпущен на обе области.
WINE_VLM=1
WINE_VLM_SCAN=0
WINE_VLM_TIMEOUT=4
# Фолбэк на решающий слой: судья отвечает только до WINE_VLM_DEADLINE с от начала запроса
# (0 — без предела), а после WINE_VLM_MAX_FAILURES ошибок облака подряд молчит
# WINE_VLM_COOLDOWN с. Облако лежит — запросы идут со скоростью пайплайна, а не 9.5 с.
WINE_VLM_DEADLINE=7
WINE_VLM_COOLDOWN=60
WINE_VLM_MAX_FAILURES=2
# Сверка выбора судьи с текстом, который он сам прочитал (цвет, сорт, сладость, различающие
# слова): стенд train 87 → 89 из 91, стресс 68 → 70 из 85; тест без изменений (91 из 93).
WINE_VLM_CHECK=1
# Строки PaddleOCR в промпт судьи: off / hint / hint-verify. На стенде не помогли (87 → 84–85).
WINE_VLM_OCR=off
# Сорт этикетки против поля grapes в правиле семьи (sibling_swap) без судьи: на стенде и тесте
# ничего не меняет, по умолчанию выключено.
WINE_GRAPE=0
WINE_VLM_PROVIDER=yandex
WINE_VLM_FALLBACK=
YANDEX_LLM_API_KEY=
# Модели AI Studio: картинки понимает qwen3.6-35b-a3b (судья); текст — yandexgpt-5-lite (сомелье).
# Полный URI gpt://<папка>/<модель> тоже принимается.
YANDEX_VLM_MODEL=qwen3.6-35b-a3b
YANDEX_LLM_MODEL=yandexgpt-5-lite
# YANDEX_LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Провайдер openai — любой OpenAI-совместимый чат (нужен VPN). Примеры: OpenAI —
# https://api.openai.com/v1, модель gpt-4.1-mini; Gemini —
# https://generativelanguage.googleapis.com/v1beta/openai, модель gemini-2.5-flash.
# Код оставлен, сейчас не используется: у ключа OpenAI нет кредитов (17.09).
WINE_VLM_BASE_URL=
WINE_VLM_MODEL=
WINE_VLM_API_KEY=

# Народный рейтинг, крепость и подача с портала vino-svoe.ru для GET /catalog/{slug}.
# 0 — не ходить на портал (карточка отдаётся из каталога без рейтинга).
WINE_PORTAL=1

# Цифровой сомелье (/sommelier). Провайдер: yandex (ключи выше) или openai
# (WINE_LLM_* или, если пусто, WINE_VLM_*). Откат: WINE_LLM_FALLBACK=<провайдер>.
WINE_SOMMELIER=0
WINE_LLM_PROVIDER=yandex
WINE_LLM_FALLBACK=
WINE_LLM_BASE_URL=
WINE_LLM_MODEL=
WINE_LLM_API_KEY=

# Eval-ручка: 0 — всегда лучший кандидат (по умолчанию: заказчик проверяет вина каталога,
# и null засчитывается ошибкой), 1 — честный null на незнакомом вине.
WINE_EVAL_REFUSE=0

# Окно ре-ранкинга: 25, как при сборке признаков решающего слоя.
WINE_RERANK_CANDIDATES=25

# PostgreSQL для аккаунтов, облачной полки и отзывов (сервис postgres в docker-compose).
POSTGRES_USER=wine
POSTGRES_PASSWORD=wine
POSTGRES_DB=wine
# Порт базы на хосте (127.0.0.1) — для web вне compose: NUXT_DATABASE_URL в web/.env.
POSTGRES_PORT=5432
# Вход по телефону: СМС-провайдер не подключён, код показывается на экране. 0 — не показывать.
AUTH_DEMO_CODES=1
# Ускорение таймеров игры «Моя винодельня» (60 — для демо: час роста за минуту).
GAME_SPEED=1

# Уведомления владельцу только из web. Если одно поле пустое, отправка отключена.
TG_NOTIFY_TOKEN=
TG_NOTIFY_TARGET=

# Порог отказа /scan поверх порога решающего слоя (meta.json). Пусто — порог решающего слоя.
WINE_THRESHOLD=0.4
# Правило выбора внутри семьи по тексту поверх решающего слоя; выключено 29.09.
WINE_SIBLING=0
